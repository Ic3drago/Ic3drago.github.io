---
// src/pages/projects.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/site';
---

<BaseLayout title="Projects">
  <div class="page-title-block">
    <h2 class="page-title">ALL PROJECTS</h2>
  </div>

  <section class="section">
    <div class="section-comment">// Projects</div>
    <h3 class="section-title">THINGS I'VE BUILT, BROKEN AND EXPERIMENTED WITH</h3>
    {projects.map(p => <ProjectCard {...p} />)}
  </section>
</BaseLayout>

<style>
  .page-title-block { margin-bottom: 2.5rem; }
  .page-title {
    font-family: var(--font-display);
    font-size: 2.2rem;
    color: var(--green);
    letter-spacing: 0.05em;
  }
  .section-comment {
    color: var(--green-comment);
    font-size: 0.85rem;
    margin-bottom: 0.3rem;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--green);
    margin-bottom: 1.2rem;
    letter-spacing: 0.05em;
  }
</style>
