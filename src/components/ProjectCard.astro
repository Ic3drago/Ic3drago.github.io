---
// src/components/ProjectCard.astro
interface Props {
  title: string;
  year: string;
  description: string;
  tags: string[];
  status: 'LIVE' | 'WIP' | 'ARCHIVED';
  github: string;
  website?: string;
}
const { title, year, description, tags, status, github, website } = Astro.props;
---

<article class="project-card">
  <div class="project-header">
    <h3 class="project-title">{title}</h3>
  </div>
  <div class="project-meta">
    <span class="project-year">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      {year}
    </span>
    {github && (
      <a href={github} target="_blank" class="project-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        Source
      </a>
    )}
    {website && (
      <a href={website} target="_blank" class="project-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        Website
      </a>
    )}
  </div>
  <p class="project-desc">{description}</p>
  <div class="project-tags">
    {tags.map(tag => <span class="tag">{tag}</span>)}
    <span class={`tag tag-status tag-${status.toLowerCase()}`}>{status}</span>
  </div>
</article>

<style>
  .project-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 1.5rem;
    margin-bottom: 1rem;
    transition: border-color 0.2s;
  }
  .project-card:hover { border-color: var(--border-bright); }
  .project-title {
    color: var(--green);
    font-size: 1.1rem;
    font-family: var(--font-mono);
    margin-bottom: 0.6rem;
  }
  .project-meta {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 1rem;
    color: var(--text-dim);
    font-size: 0.8rem;
  }
  .project-year {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .project-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--text-dim);
    font-weight: bold;
  }
  .project-link:hover { color: var(--green); }
  .project-desc {
    color: var(--green);
    margin-bottom: 1rem;
    opacity: 0.85;
    font-size: 0.9rem;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    background: var(--green-muted);
    color: var(--green);
    padding: 0.2rem 0.6rem;
    font-size: 0.75rem;
    border: 1px solid var(--border);
  }
  .tag-live { background: #003300; color: #00ff41; border-color: #00aa22; }
  .tag-wip { background: #1a1a00; color: #ffff00; border-color: #888800; }
  .tag-archived { background: #1a0000; color: #ff4444; border-color: #880000; }
</style>
