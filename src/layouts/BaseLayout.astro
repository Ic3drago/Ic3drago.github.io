---
// src/layouts/BaseLayout.astro
// LAYOUT (View layer base): Header + Nav + Footer envuelven todas las páginas

import { siteConfig } from '../data/site';
import '../styles/global.css';

const { title = siteConfig.name, description = siteConfig.tagline } = Astro.props;
const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/' || currentPath === '/portfolio/' || currentPath === '/portfolio';
  return currentPath.includes(href.replace('/', ''));
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | {siteConfig.name}</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💻</text></svg>" />
</head>
<body>

  <!-- HEADER -->
  <header class="site-header">
    <div class="header-inner">
      <div class="header-identity">
        <div class="avatar-wrap">
          <img src="/portfolio/avatar.jpg" alt={siteConfig.name} class="avatar" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
          <div class="avatar-fallback">&gt;_</div>
        </div>
        <div class="header-info">
          <span class="header-role">// {siteConfig.role}</span>
          <h1 class="header-name">{siteConfig.name.toUpperCase()}</h1>
          <div class="socials">
            <a href={siteConfig.socials.github} target="_blank" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            </a>
            <a href={siteConfig.socials.linkedin} target="_blank" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          </div>
        </div>
      </div>
      {siteConfig.available && (
        <div class="available-badge">Available for work</div>
      )}
    </div>
  </header>

  <!-- NAV -->
  <nav class="site-nav">
    <div class="nav-inner">
      {siteConfig.nav.map(item => (
        <a
          href={`/portfolio${item.href === '/' ? '' : item.href}`}
          class:list={['nav-link', { active: isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <main class="site-main">
    <div class="content-inner">
      <slot />
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="site-footer">
    <p>{siteConfig.name} © {new Date().getFullYear()}</p>
    <p>Built with <a href="https://astro.build" target="_blank">Astro</a></p>
  </footer>

</body>
</html>

<style>
  .site-header {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 1.5rem 0;
  }
  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .header-identity {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .avatar-wrap {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
  }
  .avatar {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border: 1px solid var(--border-bright);
    filter: grayscale(30%) sepia(30%) hue-rotate(80deg);
  }
  .avatar-fallback {
    display: none;
    width: 80px;
    height: 80px;
    border: 1px solid var(--border-bright);
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    color: var(--green-dim);
    background: var(--bg-card);
  }
  .header-role {
    display: block;
    color: var(--text-dim);
    font-size: 0.8rem;
  }
  .header-name {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--green);
    letter-spacing: 0.1em;
    line-height: 1.1;
  }
  .socials {
    display: flex;
    gap: 0.8rem;
    margin-top: 0.4rem;
  }
  .socials a {
    color: var(--text);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .socials a:hover { opacity: 1; }
  .available-badge {
    border: 1px solid var(--border-bright);
    padding: 0.4rem 0.9rem;
    font-size: 0.8rem;
    color: var(--text-dim);
    white-space: nowrap;
    animation: blink-border 3s ease-in-out infinite;
  }
  @keyframes blink-border {
    0%, 100% { border-color: var(--border-bright); }
    50% { border-color: var(--green-muted); }
  }

  .site-nav {
    background: var(--bg-nav);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    gap: 0;
  }
  .nav-link {
    display: block;
    padding: 0.7rem 1.4rem;
    text-decoration: none;
    color: var(--text-dim);
    font-size: 0.85rem;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .nav-link:hover, .nav-link.active {
    color: var(--green);
    background: var(--green-muted);
    border-bottom-color: var(--green);
  }

  .site-main {
    min-height: calc(100vh - 300px);
    padding: 3rem 0;
  }
  .content-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 2rem;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.8rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .site-footer a { color: var(--text-dim); }

  @media (max-width: 600px) {
    .header-inner { flex-wrap: wrap; }
    .header-name { font-size: 1.5rem; }
    .nav-link { padding: 0.7rem 0.8rem; font-size: 0.75rem; }
    .available-badge { font-size: 0.7rem; }
  }
</style>
